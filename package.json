{
  "name": "mypixelteam",
  "version": "0.1.0",
  "description": "A pixel-art open space where your AI coding agents live and work.",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "demo": "electron-vite dev -- --demo",
    "setup:claude": "node scripts/setup.mjs claude",
    "icon": "tsx scripts/make-icon.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win portable",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "electron-builder": "~26.17.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.mypixelteam.app",
    "productName": "MyPixelTeam",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "adapters/**",
      "resources/**",
      "office.config.json",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "artifactName": "MyPixelTeam.exe"
    },
    "asarUnpack": [
      "adapters/**"
    ]
  },
  "productName": "MyPixelTeam"
}
